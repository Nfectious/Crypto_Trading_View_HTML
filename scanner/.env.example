# ── Runtime ────────────────────────────────────────────────────────────────────
CANDLE_LIMIT=300              # OHLCV candles fetched per symbol/TF per cycle
SNIPER_INTERVAL_SECS=60       # seconds between full scan cycles
SIGNAL_AGE_MAX_MINS=45        # max age of a signal before it is considered stale
BACKEND_URL=http://localhost:8000
CACHE_WINDOW_DEPTH=10         # rolling history rows kept per symbol/TF in memory
REGIME_CONSENSUS_PCT=0.60     # fraction of pairs that must agree to declare a regime

# ── Binance ─────────────────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Leave blank for read-only market data — no keys required for public endpoints

# ── Targeting ───────────────────────────────────────────────────────────────────
ACTIVE_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,BNB/USDT,ATOM/USDT,NEAR/USDT,DOGE/USDT
SCAN_TIMEFRAMES=5m,15m,1h,4h  # comma-separated Binance-compatible intervals

# ── Cache ───────────────────────────────────────────────────────────────────────
MAX_CHUNK_SIZE=200             # max streams per WebSocket connection (Binance limit ~200)

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_DIR=/opt/valkyrie/logs

# ── PostgreSQL ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres         # service name in docker-compose; use 127.0.0.1 for bare-metal
POSTGRES_PORT=5432
POSTGRES_DB=valkyrie
POSTGRES_USER=valkyrie_user
POSTGRES_PASSWORD=changeme     # REQUIRED — set a strong password before production use

# ── Future Indicator Settings ───────────────────────────────────────────────────
# RSI_PERIOD=14
# EMA_FAST=20
# EMA_MID=50
# EMA_SLOW=200
# ATR_PERIOD=14
# ZSCORE_WINDOW=20
# VOL_RATIO_WINDOW=20

# ── Future Strategy Toggles ─────────────────────────────────────────────────────
# ENABLE_BREAKOUT_FILTER=true
# ENABLE_REGIME_FILTER=true
# ENABLE_PAPER_TRADING=false
